#!/usr/bin/env bash
# Startet die Quickshell-Oberfläche von hypr-shell (~/.config/quickshell/hypr-shell).
#
#   shell-quickshell            starten (falls noch nicht läuft)
#   shell-quickshell restart    neu starten
#   shell-quickshell stop       beenden
#   shell-quickshell ipc ...    Befehl an die laufende Oberfläche, z. B. "ipc dashboard toggle"
set -euo pipefail

cfg="$HOME/.config/quickshell/hypr-shell"
qs="$(command -v qs || command -v quickshell || true)"
[ -n "$qs" ] || { echo "quickshell fehlt" >&2; exit 1; }
[ -f "$cfg/shell.qml" ] || exit 0

# Symbolthema aus den Einstellungen (theme.icons), Standard Papirus-Dark
symbole() {
    local t=""
    if command -v jq >/dev/null 2>&1 && [ -f "$HOME/.local/share/hypr-shell/settings.effective.json" ]; then
        t="$(jq -r '.theme.icons // empty' "$HOME/.local/share/hypr-shell/settings.effective.json" 2>/dev/null || true)"
    fi
    printf '%s\n' "${t:-Papirus-Dark}"
}
QS_ICON_THEME="$(symbole)"
export QS_ICON_THEME

laeuft() { pgrep -f -- "-p $cfg" >/dev/null 2>&1; }
# Benachrichtigungen übernimmt hypr-shell selbst: ein von früher (oder über D-Bus) gestartetes swaync
# gibt den Dienstnamen frei, damit genau ein Benachrichtigungsdienst läuft
benachrichtigungen() {
    local an=true
    if command -v jq >/dev/null 2>&1 && [ -f "$HOME/.local/share/hypr-shell/settings.effective.json" ]; then
        an="$(jq -r 'if .notifications.enabled == false then "false" else "true" end' "$HOME/.local/share/hypr-shell/settings.effective.json" 2>/dev/null || echo true)"
    fi
    if [ "$an" = true ]; then pkill -x swaync 2>/dev/null || true; fi
}
start() { laeuft || { benachrichtigungen; setsid -f "$qs" -p "$cfg" >/dev/null 2>&1; }; }
stop() { pkill -f -- "-p $cfg" 2>/dev/null || true; }

case "${1:-start}" in
    start) start ;;
    restart) stop; sleep 0.3; start ;;
    stop) stop ;;
    ipc) shift; exec "$qs" -p "$cfg" ipc call "$@" ;;
    *) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
