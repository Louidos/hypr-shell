#!/usr/bin/env bash
# Hilfsbefehle für das Dock (nur auf Anfrage, nie im Takt).
#   shell-dock exists <ordner>…   welche Ordner es gibt: {"~/Downloads": true, …}
#   shell-dock trash              Papierkorb: {"available": true, "full": false}
#   shell-dock open <ordner>      Ordner im Dateimanager öffnen
#   shell-dock open-trash         Papierkorb im Dateimanager öffnen
#   shell-dock recent <ordner>    die 10 neuesten Dateien als JSON [{"name", "path"}]
#   shell-dock file <datei>       Datei mit dem Standardprogramm öffnen
#   shell-dock empty-trash        Papierkorb leeren (das Dock fragt vorher nach)
set -euo pipefail

TRASH="${XDG_DATA_HOME:-$HOME/.local/share}/Trash"
EFF="$HOME/.local/share/hypr-shell/settings.effective.json"

hat() { command -v "$1" >/dev/null 2>&1; }
# shellcheck disable=SC2088  # "~" ist hier Text aus den Einstellungen
pfad() { case "$1" in "~") printf '%s\n' "$HOME" ;; "~/"*) printf '%s\n' "$HOME/${1#"~/"}" ;; *) printf '%s\n' "$1" ;; esac; }

dateimanager() {
    local f=""
    if hat jq && [ -f "$EFF" ]; then f="$(jq -r '.apps.files // empty' "$EFF" 2>/dev/null || true)"; fi
    printf '%s\n' "${f:-nautilus}"
}

oeffnen() { # ziel (Pfad oder trash:///)
    local fm
    fm="$(dateimanager)"
    if hat "${fm%% *}"; then
        # shellcheck disable=SC2086
        setsid -f $fm "$1" >/dev/null 2>&1
    elif hat gio; then
        setsid -f gio open "$1" >/dev/null 2>&1
    else
        setsid -f xdg-open "$1" >/dev/null 2>&1
    fi
}

case "${1:-}" in
    exists)
        shift
        out="{" sep=""
        for p in "$@"; do
            if [ -d "$(pfad "$p")" ]; then v=true; else v=false; fi
            out+="$sep$(jq -n --arg p "$p" '$p'): $v"; sep=", "
        done
        printf '%s}\n' "$out" ;;
    trash)
        da=false voll=false
        if hat gio || hat "$(dateimanager | cut -d' ' -f1)"; then da=true; fi
        if [ -d "$TRASH/files" ] && [ -n "$(ls -A "$TRASH/files" 2>/dev/null)" ]; then voll=true; fi
        printf '{"available": %s, "full": %s}\n' "$da" "$voll" ;;
    open) [ -n "${2:-}" ] || exit 2; oeffnen "$(pfad "$2")" ;;
    open-trash) oeffnen "trash:///" ;;
    recent)
        d="$(pfad "${2:-}")"
        [ -d "$d" ] || { echo '[]'; exit 0; }
        find "$d" -maxdepth 1 -type f ! -name '.*' -printf '%T@\t%f\n' 2>/dev/null | sort -rn | head -n 10 | cut -f2- \
            | jq -R --arg d "$d" '{name: ., path: ($d + "/" + .)}' | jq -s -c '.' ;;
    file) [ -f "${2:-}" ] || exit 1; setsid -f xdg-open "$2" >/dev/null 2>&1 ;;
    empty-trash)
        if hat gio && gio trash --empty 2>/dev/null; then exit 0; fi
        [ -d "$TRASH" ] || exit 0
        find "$TRASH/files" "$TRASH/info" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true ;;
    *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
