/* erzeugt von matugen (hypr-shell), nicht von Hand ändern */
* {
    accent:    {{colors.primary.default.hex}};
    on-accent: {{colors.on_primary.default.hex}};
    surface:   {{colors.surface.default.hex}}70;
    text:      {{colors.on_surface.default.hex}};
    subtext:   {{colors.on_surface_variant.default.hex}};
}
