#!/usr/bin/env bash
# Zugangsdaten von hypr-shell: ~/.config/hypr-shell/secrets.env (nur für den Benutzer lesbar, 600).
# Nie in settings.json, Profilen, Export, Logs oder im Repo. Werte kommen über stdin, nie als Argument.
#   shell-secrets set <NAME>     Wert aus stdin (erste Zeile) speichern
#   shell-secrets has <NAME>     Rückgabe 0, wenn gesetzt (gibt nichts aus)
#   shell-secrets get <NAME>     Wert ausgeben (nur für die Skripte von hypr-shell)
#   shell-secrets unset <NAME>   entfernen
#   shell-secrets list           gesetzte Namen (ohne Werte)
# Namen: NEXTCLOUD_APP_PASSWORD, MISSA_API_KEY, MISSA_DEVICE_TOKEN, CALDAV_PASSWORD, SENSOR_TOKEN
set -uo pipefail

FILE="${HYPR_SHELL_SECRETS:-$HOME/.config/hypr-shell/secrets.env}"
NAMEN="NEXTCLOUD_APP_PASSWORD MISSA_API_KEY MISSA_DEVICE_TOKEN CALDAV_PASSWORD SENSOR_TOKEN"

pruefe_name() {
    case " $NAMEN " in *" $1 "*) return 0 ;; esac
    echo "shell-secrets: unbekannter Name $1 (erlaubt: $NAMEN)" >&2
    exit 2
}
datei() {
    umask 077
    mkdir -p "$(dirname "$FILE")"
    [ -f "$FILE" ] || : > "$FILE"
    chmod 600 "$FILE"
}
# Wert lesen: Zeilen NAME=<base64>, damit beliebige Zeichen sicher sind und nichts ausgewertet wird
lesen() { [ -f "$FILE" ] && sed -n "s/^$1=//p" "$FILE" | tail -n1 | base64 -d 2>/dev/null; }

case "${1:-}" in
    set)
        pruefe_name "${2:-}"
        IFS= read -r wert || true
        [ -n "$wert" ] || { echo "shell-secrets: leerer Wert – nichts gespeichert" >&2; exit 1; }
        datei
        tmp="$(mktemp "$FILE.XXXXXX")"
        chmod 600 "$tmp"
        { grep -v "^$2=" "$FILE" || true; printf '%s=%s\n' "$2" "$(printf '%s' "$wert" | base64 -w0)"; } > "$tmp"
        mv -f "$tmp" "$FILE"
        ;;
    has) pruefe_name "${2:-}"; [ -n "$(lesen "$2")" ] ;;
    get) pruefe_name "${2:-}"; lesen "$2" ;;
    unset)
        pruefe_name "${2:-}"
        [ -f "$FILE" ] || exit 0
        tmp="$(mktemp "$FILE.XXXXXX")"; chmod 600 "$tmp"
        grep -v "^$2=" "$FILE" > "$tmp" || true
        mv -f "$tmp" "$FILE" ;;
    list) [ -f "$FILE" ] && sed -n 's/^\([A-Z_]*\)=.*/\1/p' "$FILE" ;;
    *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
