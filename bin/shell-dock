#!/usr/bin/env bash
# Hilfsbefehle für das Dock (nur auf Anfrage, nie im Takt).
#   shell-dock exists <ordner>…   welche Ordner es gibt: {"~/Downloads": true, …}
#   shell-dock trash              Papierkorb: {"available": true, "full": false}
#   shell-dock open <ordner>      Ordner im Dateimanager öffnen
#   shell-dock open-trash         Papierkorb im Dateimanager öffnen
#   shell-dock recent <ordner>    die 10 neuesten Dateien als JSON [{"name", "path"}]
#   shell-dock file <datei>       Datei mit dem Standardprogramm öffnen
#   shell-dock empty-trash        Papierkorb leeren (das Dock fragt vorher nach)
#   shell-dock presets            Voreinstellungen als JSON [{"name", "description"}]
#   shell-dock preset <name>      Voreinstellung anwenden (nur dock.*-Werte, nie dock.items)
#   shell-dock export <datei>     alle dock.*-Werte (mit dock.items) als JSON-Datei
#   shell-dock import <datei>     dock.*-Werte aus einer Datei: alles oder nichts
#   shell-dock reset              alle dock.*-Werte auf den Standard
set -euo pipefail

TRASH="${XDG_DATA_HOME:-$HOME/.local/share}/Trash"
DATA="$HOME/.local/share/hypr-shell"
EFF="$DATA/settings.effective.json"
SCHEMA="$DATA/schema.json"
BIN="$HOME/.local/bin"
# Voreinstellungen: installiert unter ~/.local/share/hypr-shell/presets/dock, sonst aus dem Repo
REPO_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." 2>/dev/null && pwd)"
PRESETS="$DATA/presets/dock"
[ -d "$PRESETS" ] || PRESETS="$REPO_DIR/settings/presets/dock"
[ -f "$SCHEMA" ] || SCHEMA="$REPO_DIR/settings/schema.json"

fehler() { echo "shell-dock: $*" >&2; exit 1; }
# alle dock.*-Schlüssel ausser dock.items und dock.preset
dock_schluessel() { jq -r '.keys[] | select(.key | startswith("dock.")) | select(.key != "dock.items" and .key != "dock.preset") | .key' "$SCHEMA"; }

hat() { command -v "$1" >/dev/null 2>&1; }
# shellcheck disable=SC2088  # "~" ist hier Text aus den Einstellungen
pfad() { case "$1" in "~") printf '%s\n' "$HOME" ;; "~/"*) printf '%s\n' "$HOME/${1#"~/"}" ;; *) printf '%s\n' "$1" ;; esac; }

dateimanager() {
    local f=""
    if hat jq && [ -f "$EFF" ]; then f="$(jq -r '.apps.files // empty' "$EFF" 2>/dev/null || true)"; fi
    printf '%s\n' "${f:-nautilus}"
}

oeffnen() { # ziel (Pfad oder trash:///)
    local fm
    fm="$(dateimanager)"
    if hat "${fm%% *}"; then
        # shellcheck disable=SC2086
        setsid -f $fm "$1" >/dev/null 2>&1
    elif hat gio; then
        setsid -f gio open "$1" >/dev/null 2>&1
    else
        setsid -f xdg-open "$1" >/dev/null 2>&1
    fi
}

case "${1:-}" in
    exists)
        shift
        out="{" sep=""
        for p in "$@"; do
            if [ -d "$(pfad "$p")" ]; then v=true; else v=false; fi
            out+="$sep$(jq -n --arg p "$p" '$p'): $v"; sep=", "
        done
        printf '%s}\n' "$out" ;;
    trash)
        da=false voll=false
        if hat gio || hat "$(dateimanager | cut -d' ' -f1)"; then da=true; fi
        if [ -d "$TRASH/files" ] && [ -n "$(ls -A "$TRASH/files" 2>/dev/null)" ]; then voll=true; fi
        printf '{"available": %s, "full": %s}\n' "$da" "$voll" ;;
    open) [ -n "${2:-}" ] || exit 2; oeffnen "$(pfad "$2")" ;;
    open-trash) oeffnen "trash:///" ;;
    recent)
        d="$(pfad "${2:-}")"
        [ -d "$d" ] || { echo '[]'; exit 0; }
        find "$d" -maxdepth 1 -type f ! -name '.*' -printf '%T@\t%f\n' 2>/dev/null | sort -rn | head -n 10 | cut -f2- \
            | jq -R --arg d "$d" '{name: ., path: ($d + "/" + .)}' | jq -s -c '.' ;;
    file) [ -f "${2:-}" ] || exit 1; setsid -f xdg-open "$2" >/dev/null 2>&1 ;;
    empty-trash)
        if hat gio && gio trash --empty 2>/dev/null; then exit 0; fi
        [ -d "$TRASH" ] || exit 0
        find "$TRASH/files" "$TRASH/info" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true ;;
    presets)
        for f in "$PRESETS"/*.json; do [ -f "$f" ] && jq -c '{name: ._name, description: ._description}' "$f"; done | jq -s -c '.' ;;
    preset)
        name="${2:-}"; f="$PRESETS/$name.json"
        if ! [[ "$name" =~ ^[a-z]+$ ]] || [ ! -f "$f" ]; then fehler "unbekannte Voreinstellung: $name"; fi
        # jeder dock.*-Wert: aus der Voreinstellung, sonst der Standard aus dem Schema; dock.items bleibt
        args=()
        while IFS=$'\t' read -r k v; do args+=("$k" "$v"); done < <(
            jq -r --slurpfile p "$f" '.keys[] | select(.key | startswith("dock.")) | select(.key != "dock.items" and .key != "dock.preset")
                | .key as $k | [$k, ((if ($p[0] | has($k)) then $p[0][$k] else .default end) | if type == "string" then . else tojson end)] | @tsv' "$SCHEMA")
        args+=(dock.preset "$name")
        "$BIN/shell-set" set "${args[@]}" ;;
    export)
        ziel="${2:-}"; [ -n "$ziel" ] || fehler "Datei fehlt"
        [ -f "$EFF" ] || fehler "keine Einstellungen ($EFF)"
        jq '{dock: .dock}' "$EFF" > "$ziel.tmp.$$" && mv -f "$ziel.tmp.$$" "$ziel"
        echo "$ziel" ;;
    import)
        quelle="${2:-}"; [ -f "$quelle" ] || fehler "Datei nicht gefunden: $quelle"
        jq -e '(.dock | type) == "object"' "$quelle" >/dev/null 2>&1 || fehler "keine gültige Dock-Datei (erwartet {\"dock\": {…}})"
        # nur bekannte dock.*-Schlüssel, jeder Wert gültig – sonst wird nichts übernommen
        unbekannt="$(jq -r --slurpfile s "$SCHEMA" '[.dock | keys[] | "dock." + .] - [$s[0].keys[].key] | join(", ")' "$quelle")"
        [ -z "$unbekannt" ] || fehler "unbekannte Werte: $unbekannt – nichts übernommen"
        tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
        jq -n --slurpfile d "$quelle" '{dock: $d[0].dock}' > "$tmp/probe.json"
        if ! "$BIN/shell-apply" --check "$tmp/probe.json" > "$tmp/check.txt" 2>&1; then
            sed 's/^/  /' "$tmp/check.txt" >&2
            fehler "ungültige Werte – nichts übernommen"
        fi
        args=()
        while IFS=$'\t' read -r k v; do args+=("$k" "$v"); done < <(jq -r '.dock | to_entries[] | ["dock." + .key, (.value | if type == "string" then . else tojson end)] | @tsv' "$quelle")
        [ "${#args[@]}" -gt 0 ] || exit 0
        "$BIN/shell-set" set "${args[@]}" ;;
    reset) "$BIN/shell-set" reset dock ;;
    *) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
