#!/usr/bin/env bash
# Spiele für hypr-shell: zuletzt gespielte Steam-Spiele (aus den lokalen Steam-Dateien) und eigene
# Einträge (games.custom, nur mit games.custom_enabled), dazu der automatische Gaming-Modus.
#   shell-games list                       JSON, zuletzt gespielte zuerst:
#                                          [{"id", "name", "last", "cover", "source": "steam"|"custom"}]
#   shell-games launch <id>                Spiel starten (Steam-ID oder custom:<nr>)
#   shell-games auto fullscreen <modus> <klasse> <adresse>
#   shell-games auto close <adresse>       von hyprland.lua bei Vollbild-Wechsel bzw. Schliessen aufgerufen:
#                                          ein Spiel im Vollbild schaltet den Gaming-Modus an, danach wieder aus
#                                          (games.auto_gaming; ein von Hand eingeschalteter Modus bleibt)
set -uo pipefail
# fehlendes Argument: klare Meldung und Ende (statt "Zeile N: 2: … fehlt" oder still weiter)
fehlt() { echo "shell-games: $1" >&2; exit 2; }

DATA="$HOME/.local/share/hypr-shell"
EFF="$DATA/settings.effective.json"
MARKE="$DATA/gaming-auto"
HIER="$(dirname "$(readlink -f "$0")")"
hat() { command -v "$1" >/dev/null 2>&1; }
wert() {
    local v=""
    if hat jq && [ -f "$EFF" ]; then v="$(jq -c "($1) | if . == null then empty else . end" "$EFF" 2>/dev/null || true)"; fi
    printf '%s\n' "${v:-$2}"
}

steam_dir() {
    local d
    for d in "${HYPR_SHELL_STEAM:-}" "$HOME/.local/share/Steam" "$HOME/.steam/steam" "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"; do
        [ -n "$d" ] && [ -d "$d/steamapps" ] && { printf '%s\n' "$d"; return 0; }
    done
    return 1
}

# Bibliotheken aus libraryfolders.vdf ("path"  "/pfad"), dazu der Steam-Ordner selbst
bibliotheken() {
    local s="$1"
    printf '%s\n' "$s"
    [ -f "$s/steamapps/libraryfolders.vdf" ] && sed -n 's/^[[:space:]]*"path"[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$s/steamapps/libraryfolders.vdf"
}

# zuletzt gespielt aus userdata/*/config/localconfig.vdf: "id<TAB>zeit" (Schlüssel auf Ebene apps)
localconfig() {
    local s="$1" f
    for f in "$s"/userdata/*/config/localconfig.vdf; do
        [ -f "$f" ] || continue
        awk '
            /^[[:space:]]*"[0-9]+"[[:space:]]*$/ { gsub(/[[:space:]"]/, ""); id = $0; next }
            /"LastPlayed"/ && id != "" { v = $0; gsub(/.*"LastPlayed"[[:space:]]*"|".*/, "", v); print id "\t" v }
            /^[[:space:]]*}[[:space:]]*$/ { id = "" }' "$f"
    done
}

cover() { # steam-ordner id
    local c="$1/appcache/librarycache" f
    for f in "$c/${2}_library_600x900.jpg" "$c/$2/library_600x900.jpg" "$c/$2"/*/library_600x900.jpg "$c/$2/library_capsule.jpg"; do
        [ -f "$f" ] && { printf '%s\n' "$f"; return 0; }
    done
    printf '\n'
}

steam_liste() {
    local s lib f id name last zeiten l2
    s="$(steam_dir)" || return 0
    zeiten="$(localconfig "$s")"
    while IFS= read -r lib; do
        for f in "$lib"/steamapps/appmanifest_*.acf; do
            [ -f "$f" ] || continue
            id="$(sed -n 's/^[[:space:]]*"appid"[[:space:]]*"\([0-9]*\)".*/\1/p' "$f" | head -n1)"
            name="$(sed -n 's/^[[:space:]]*"name"[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$f" | head -n1)"
            last="$(sed -n 's/^[[:space:]]*"LastPlayed"[[:space:]]*"\([0-9]*\)".*/\1/p' "$f" | head -n1)"
            if [ -z "$id" ] || [ -z "$name" ]; then continue; fi
            # Werkzeuge sind keine Spiele
            case "$name" in Proton*|"Steam Linux Runtime"*|"Steamworks Common"*|"SteamVR"*) continue ;; esac
            l2="$(awk -F'\t' -v id="$id" '$1 == id { print $2 }' <<<"$zeiten" | sort -n | tail -n1)"
            if [ -n "${l2:-}" ] && [ "${l2:-0}" -gt "${last:-0}" ]; then last="$l2"; fi
            jq -cn --arg id "$id" --arg name "$name" --argjson last "${last:-0}" --arg cover "$(cover "$s" "$id")" \
                '{id: $id, name: $name, last: $last, cover: $cover, source: "steam"}'
        done
    done < <(bibliotheken "$s" | sort -u)
}

eigene_liste() {
    [ "$(wert '.games.custom_enabled' false)" = true ] || return 0
    wert '.games.custom' '[]' | jq -c 'to_entries[] | select(.value.name != "" and .value.command != "")
        | {id: "custom:\(.key)", name: .value.name, last: 0, cover: (.value.image // ""), source: "custom"}'
}

liste() {
    hat jq || { echo '[]'; return 0; }
    { steam_liste; eigene_liste; } | jq -cs 'sort_by(-.last) | (map(select(.last > 0)) + map(select(.last == 0)))[:18]'
}

starten() {
    local id="$1"
    if [[ "$id" =~ ^[0-9]+$ ]]; then
        hat steam || { echo "steam fehlt" >&2; return 1; }
        setsid -f steam "steam://rungameid/$id" >/dev/null 2>&1
    elif [[ "$id" =~ ^custom:([0-9]+)$ ]]; then
        [ "$(wert '.games.custom_enabled' false)" = true ] || return 1
        local cmd
        cmd="$(wert '.games.custom' '[]' | jq -r --argjson i "${BASH_REMATCH[1]}" '.[$i].command // empty')"
        [ -n "$cmd" ] && setsid -f bash -c "$cmd" >/dev/null 2>&1
    else
        echo "shell-games: unbekanntes Spiel $id" >&2; return 2
    fi
}

ist_spiel() { # klasse
    local muster
    while IFS= read -r muster; do
        [ -n "$muster" ] && [[ "$1" =~ ^($muster)$ ]] && return 0
    done < <(wert '.games.auto_classes' '["steam_app_[0-9]+","gamescope"]' | jq -r '.[]')
    return 1
}

# Adresse vergleichbar machen: 0x…, klein, ohne führende Nullen ("0x0ABC", "abc" → "0xabc")
adr() {
    local a="${1,,}"
    a="${a#0x}"
    [[ "$a" =~ ^[0-9a-f]+$ ]] || { printf '%s\n' "$1"; return 0; }
    a="${a#"${a%%[!0]*}"}"
    printf '0x%s\n' "${a:-0}"
}

# Ist (ausser dem Fenster mit Adresse $1) noch ein Spiel im Vollbild? Fragt Hyprland; ohne hyprctl
# oder ohne laufendes Hyprland: unbekannt (Rückgabe 2)
noch_spiel() {
    command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && hat jq || return 2
    local clients adresse klasse ohne
    ohne="$(adr "$1")"
    clients="$(hyprctl -j clients 2>/dev/null)" || return 2
    while IFS=$'\t' read -r adresse klasse; do
        [ -n "$adresse" ] || continue
        [ "$(adr "$adresse")" = "$ohne" ] && continue
        ist_spiel "$klasse" && return 0
    done < <(jq -r '.[]? | select(.mapped != false) | select(.fullscreen == 2 or .fullscreen == true)
                     | [.address, .class] | @tsv' <<<"$clients" 2>/dev/null)
    return 1
}

auto_aus() { rm -f "$MARKE"; "$HIER/shell-toggle" gaming off >/dev/null 2>&1; }

auto() {
    [ "$(wert '.games.auto_gaming' true)" = true ] || return 0
    local toggle="$HIER/shell-toggle" marke
    marke="$(adr "$(cat "$MARKE" 2>/dev/null)")"
    case "$1" in
        fullscreen)
            local modus="${2:-}" klasse="${3:-}" adresse
            adresse="$(adr "${4:-}")"
            if [ "$modus" = 2 ] && ist_spiel "$klasse"; then
                # nur einschalten, wenn der Modus aus ist (ein von Hand eingeschalteter bleibt in Ruhe)
                if [ ! -e "$DATA/gaming" ]; then "$toggle" gaming on >/dev/null 2>&1; echo "$adresse" > "$MARKE"; fi
            elif [ "$modus" != 2 ] && [ -e "$MARKE" ] && [ "$marke" = "$adresse" ]; then
                auto_aus
            fi ;;
        close)
            # nur ein automatisch eingeschalteter Modus (Marke gaming-auto) geht hier aus
            [ -e "$MARKE" ] || return 0
            if [ "$marke" = "$(adr "${2:-}")" ]; then auto_aus; return 0; fi
            # anderes oder unbekanntes Fenster: kurz warten, bis Hyprland es entfernt hat, dann
            # nachsehen, ob noch ein Spiel im Vollbild ist – sonst ist das Spiel weg, Modus aus
            sleep "${HYPR_SHELL_GAMES_WAIT:-0.4}"
            noch_spiel "${2:-}"
            [ "$?" = 1 ] && auto_aus
            return 0 ;;
    esac
}

case "${1:-}" in
    list) liste ;;
    launch) [ -n "${2:-}" ] || fehlt "Spiel fehlt"; starten "${2}" ;;
    auto) shift; auto "$@" ;;
    *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
