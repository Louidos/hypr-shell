#!/usr/bin/env bash
# Attrappe von asusctl 6.3+ (ASUS_ALT=1: Schreibweise bis 6.2). Zustand in $ASUS_STATE/…
d="${ASUS_STATE:-/tmp/asus}"; mkdir -p "$d"
echo "$*" >> "$d/log"
# wie asusd: neue Ladegrenze auch in die (nachgebaute) sysfs-Datei, aber nie ins echte /sys
grenze() {
    echo "$1" > "$d/charge"
    if [ -n "${HYPR_SHELL_SYSFS:-}" ]; then
        for f in "$HYPR_SHELL_SYSFS"/class/power_supply/BAT*/charge_control_end_threshold; do [ -f "$f" ] && echo "$1" > "$f"; done
    fi
    return 0
}
p="$(cat "$d/profile" 2>/dev/null || echo Balanced)"
if [ "${ASUS_ALT:-0}" = 1 ]; then
    case "$*" in
        "profile get"*) echo "error: unknown subcommand" >&2; exit 1 ;;
        "profile -p") echo "Active profile is $p" ;;
        "profile -P "*) echo "$3" > "$d/profile" ;;
        "-c "*) grenze "$2" ;;
        "-k "*) echo "$2" > "$d/kbd" ;;
        "aura static -c "*) echo "$4" > "$d/color" ;;
        *) exit 1 ;;
    esac
    exit 0
fi
case "$*" in
    "profile get") printf 'Active profile: %s\n\nAC profile Performance\nBattery profile Quiet\n' "$p" ;;
    "profile list") printf 'Quiet\nBalanced\nPerformance\n' ;;
    "profile set "*) echo "$3" > "$d/profile" ;;
    "battery limit "*) grenze "$3" ;;
    "battery info") echo "Current battery charge limit: $(cat "$d/charge" 2>/dev/null || echo 100)%" ;;
    "leds set "*) echo "$3" > "$d/kbd" ;;
    "aura effect static -c "*) echo "$5" > "$d/color" ;;
    *) exit 1 ;;
esac
