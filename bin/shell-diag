#!/usr/bin/env bash
# Diagnose und Notfall-Hilfe für hypr-shell.
#
#   shell-diag tastatur     wer hat gerade die Tastatur? (Flächen der Shell, offenes Panel,
#                           Submap von Hyprland, aktives Fenster) – mit Hinweisen
#   shell-diag dock         Dock pro Bildschirm: sichtbar, Eingabe, versteckt, und ob es als
#                           „Vollbild“ gilt und warum (hasFullscreen der Arbeitsfläche, Vollbild-
#                           Fenster, Gaming-Modus) – Sicht der Oberfläche und Sicht von Hyprland
#   shell-diag freigeben    Tastatur zurück (auch SUPER+CTRL+Escape): alle Panels zu, Dock-Tastatur-
#                           Modus und Bearbeiten-Modus aus, Submap verlassen, Fokus auf das Fenster
#                           unter der Maus
#
# Ohne Hyprland oder ohne laufende Oberfläche wird der jeweilige Teil übersprungen (mit Hinweis).
set -uo pipefail
fehlt() { echo "shell-diag: $1" >&2; exit 2; }

HIER="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
ui() { "$HIER/shell-quickshell" ipc shell "$@" 2>/dev/null; }
hat() { command -v "$1" >/dev/null 2>&1; }
hypr() { hat hyprctl && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; }

# Fenster unter der Maus auf einer sichtbaren Arbeitsfläche (schwebende zuerst, dann das zuletzt
# benutzte) – Adresse oder leer
fenster_unter_maus() {
    hat jq || return 0
    local pos mons clients
    pos="$(hyprctl -j cursorpos 2>/dev/null)" || return 0
    mons="$(hyprctl -j monitors 2>/dev/null)" || return 0
    clients="$(hyprctl -j clients 2>/dev/null)" || return 0
    jq -rn --argjson p "${pos:-{\}}" --argjson m "${mons:-[]}" --argjson c "${clients:-[]}" '
        ([$m[] | .activeWorkspace.id, (.specialWorkspace.id // empty)] | map(select(. != null and . != 0))) as $ws
        | [$c[] | select(.mapped != false and .hidden != true)
                | select(.workspace.id as $w | $ws | index($w))
                | select(($p.x // -1) >= .at[0] and ($p.x // -1) < .at[0] + .size[0] and ($p.y // -1) >= .at[1] and ($p.y // -1) < .at[1] + .size[1])]
        | sort_by((if .floating then 0 else 1 end), (.focusHistoryID // 999))
        | .[0].address // empty' 2>/dev/null
}

tastatur() {
    local panel flaechen sub aktiv
    echo "== Tastatur"
    if panel="$(ui current)"; then
        flaechen="$(ui keyboard)"
        echo "  offenes Panel (Ui.panel):        ${panel:-keines}"
        echo "  Flächen der Shell mit Tastatur:  ${flaechen:-keine}"
    else
        panel=""; flaechen=""
        echo "  Oberfläche (Quickshell) läuft nicht oder antwortet nicht"
    fi
    if hypr; then
        sub="$(hyprctl submap 2>/dev/null | head -n1)"
        aktiv="$( (hyprctl -j activewindow 2>/dev/null || echo '{}') | jq -r 'if .class then "\(.class) – \(.title)" else "keines" end' 2>/dev/null)"
        echo "  Submap von Hyprland:             ${sub:-default}"
        echo "  aktives Fenster:                 ${aktiv:-?}"
        hyprctl -j layers 2>/dev/null | jq -r '[.. | objects | select(has("namespace")) | .namespace | select(startswith("hypr-shell"))] | unique | "  Flächen der Shell (Layer):       " + (if length == 0 then "keine" else join(", ") end)' 2>/dev/null
    else
        sub=""
        echo "  Hyprland läuft nicht (Submap und Fenster übersprungen)"
    fi
    echo
    if [ -n "$flaechen" ] && [ -z "$panel" ]; then
        echo "  Hinweis: eine Fläche hält die Tastatur, obwohl kein Panel offen ist ($flaechen)."
    fi
    if [ -n "$sub" ] && [ "$sub" != default ]; then
        echo "  Hinweis: Hyprland steckt in der Submap \"$sub\"."
    fi
    echo "  Tastatur zurück: CTRL + SUPER + Escape  (oder: shell-diag freigeben)"
}

dock() {
    local st grund
    echo "== Dock"
    hat jq || { echo "  jq fehlt"; return 0; }
    # HYPR_SHELL_DIAG_DOCK: Antwort der Oberfläche vorgeben (für Tests)
    st="${HYPR_SHELL_DIAG_DOCK:-}"
    [ -n "$st" ] || st="$("$HIER/shell-quickshell" ipc dock screens 2>/dev/null)" || st=""
    if [ -n "$st" ]; then
        jq -r '"  dock.autohide: \(.autohide)   Neuholen von Hyprland bisher: \(.refreshes)×",
            (.docks[] | "  \(.screen): \(if .shown then "sichtbar" else "NICHT sichtbar" end), Eingabe \(if .input then "an" else "aus (Panel offen)" end), Fläche \(.region)\(if .hidden then ", versteckt (Kante)" else "" end)\(if .keyboard then ", Tastatur-Modus" else "" end)",
                "      Vollbild: \(if .fullscreen then "ja" else "nein" end) – \(
                    {"gaming": "Gaming-Modus ist an", "fullscreen-window": "Vollbild-Fenster auf der Arbeitsfläche",
                     "stale-hasfullscreen-ignored": "Hyprland meldet hasFullscreen ohne Vollbild-Fenster (veraltet, wird ignoriert)",
                     "hide_on_fullscreen-off": "dock.hide_on_fullscreen ist aus", "none": "kein Vollbild"}[.reason] // .reason)",
                "      Arbeitsfläche \(.workspace // "?"): hasFullscreen \(.hasFullscreen), Vollbild-Fenster: \(if (.fullscreenWindows | length) == 0 then "keine" else (.fullscreenWindows | map("\(.class) \(.address)") | join(", ")) end), Gaming-Modus \(if .gaming then "an" else "aus" end)")' <<<"$st" 2>/dev/null \
            || echo "  Antwort der Oberfläche unlesbar: $st"
    else
        echo "  Oberfläche (Quickshell) läuft nicht oder antwortet nicht"
    fi
    echo "  Gaming-Modus (Datei): $(if [ -e "$HOME/.local/share/hypr-shell/gaming" ]; then echo an; else echo aus; fi)$(if [ -e "$HOME/.local/share/hypr-shell/gaming-auto" ]; then echo " – automatisch, Spiel $(cat "$HOME/.local/share/hypr-shell/gaming-auto")"; fi)"
    if hypr; then
        echo "  Sicht von Hyprland:"
        jq -rn --argjson m "$(hyprctl -j monitors 2>/dev/null || echo '[]')" --argjson w "$(hyprctl -j workspaces 2>/dev/null || echo '[]')" \
            --argjson c "$(hyprctl -j clients 2>/dev/null || echo '[]')" '
            $m[] | .name as $n | .activeWorkspace.id as $id
            | ([$w[] | select(.id == $id)][0].hasfullscreen // false) as $hf
            | [$c[] | select(.workspace.id == $id and .mapped != false and ((.fullscreen // 0) == true or (.fullscreen // 0) > 0))] as $f
            | "    \($n): Arbeitsfläche \($id), hasfullscreen \($hf), Vollbild-Fenster \(if ($f | length) == 0 then "keine" else ($f | map("\(.class) \(.address) (Modus \(.fullscreen))") | join(", ")) end)\(if $hf == true and ($f | length) == 0 then "  ← veraltet: das Dock ignoriert das" else "" end)"' 2>/dev/null
    else
        echo "  Hyprland läuft nicht (Sicht von Hyprland übersprungen)"
    fi
    grund=""
    [ -n "${st:-}" ] && grund="$(jq -r '[.docks[] | select(.shown == false and .reason != "gaming" and .reason != "fullscreen-window")] | length' <<<"$st" 2>/dev/null)"
    if [ "${grund:-0}" != 0 ]; then echo "  Hinweis: ein Dock ist ohne Vollbild unsichtbar – mit \"shell-quickshell ipc dock show\" einblenden."; fi
}

freigeben() {
    local rest addr
    if rest="$(ui release)"; then
        echo "  Panels zu, Dock-Tastatur-Modus aus${rest:+ (hält noch: $rest)}"
    else
        echo "  Oberfläche antwortet nicht – nichts zu schliessen"
    fi
    if hypr; then
        hyprctl dispatch 'hl.dsp.submap("reset")' >/dev/null 2>&1 && echo "  Submap verlassen"
        addr="$(fenster_unter_maus)"
        if [ -n "$addr" ]; then
            hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null 2>&1 && echo "  Fokus auf das Fenster unter der Maus ($addr)"
        fi
    else
        echo "  Hyprland läuft nicht – Submap und Fokus übersprungen"
    fi
}

case "${1:-}" in
    tastatur|keyboard) tastatur ;;
    freigeben|release) freigeben ;;
    dock) dock ;;
    ""|-h|--help|help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) fehlt "unbekannter Befehl: $1 (tastatur, dock, freigeben)" ;;
esac
